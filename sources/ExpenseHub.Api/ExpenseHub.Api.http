@ExpenseHub_Api_HostAddress = http://localhost:5245
@adminEmail = admin@expensehub.local
@adminPassword = {{$processEnv EXPENSEHUB_ADMIN_PASSWORD}}
@userPassword = {{$processEnv EXPENSEHUB_USER_PASSWORD}}

# Fluxo: Admin faz login -> usuário se registra (sem role) -> Admin atribui roles
# -> o usuário faz NOVO login (o token antigo recebe 401 depois da troca de roles).

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

### Login do Admin (seed)
# @name loginAdmin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
@adminToken = {{loginAdmin.response.body.$.accessToken}}

### Cadastro de um funcionário (nunca aceita roles)
# @name registerEmployee
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "employee@expensehub.local",
  "password": "{{userPassword}}"
}

###
@employeeId = {{registerEmployee.response.body.$.id}}

### Admin lista usuários
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Admin atribui a role Employee
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{employeeId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

### Login do funcionário (refazer depois de qualquer troca de roles)
# @name loginEmployee
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "employee@expensehub.local",
  "password": "{{userPassword}}"
}

###
@employeeToken = {{loginEmployee.response.body.$.accessToken}}

### Roles presentes no token
GET {{ExpenseHub_Api_HostAddress}}/api/me
Authorization: Bearer {{employeeToken}}

### Cria um rascunho
# @name createExpense
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente no centro",
  "amount": 87.50,
  "expenseDate": "2026-10-14",
  "categoryId": 1
}

###
@expenseId = {{createExpense.response.body.$.id}}

### Edita o rascunho
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente no centro (corrigido)",
  "amount": 92.00,
  "expenseDate": "2026-10-14",
  "categoryId": 1
}

### Consulta o detalhe
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeToken}}

### Lista conforme o perfil
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}

### Envia para aprovação
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeToken}}

### Negativos: campo proibido (ownerId) -> 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente no centro",
  "amount": 10,
  "expenseDate": "2026-10-14",
  "categoryId": 1,
  "ownerId": "outro-usuario"
}

### Negativos: sem token -> 401
GET {{ExpenseHub_Api_HostAddress}}/api/expenses

### Cadastro de um aprovador
# @name registerApprover
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "approver@expensehub.local",
  "password": "{{userPassword}}"
}

###
@approverId = {{registerApprover.response.body.$.id}}

### Admin atribui a role Approver
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{approverId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Approver"]
}

### Login do aprovador
# @name loginApprover
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "approver@expensehub.local",
  "password": "{{userPassword}}"
}

###
@approverToken = {{loginApprover.response.body.$.accessToken}}

### Aprovador lista os reembolsos enviados
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{approverToken}}

### Aprova o reembolso enviado -> 200 (Approved)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

### Negativos: aprovar de novo -> 409 (sem duplicar histórico)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{approverToken}}

### Negativos: Employee não aprova -> 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/approve
Authorization: Bearer {{employeeToken}}

### Cria um segundo rascunho para a reprovação
# @name createExpenseToReject
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "description": "Táxi do aeroporto até o hotel",
  "amount": 120.00,
  "expenseDate": "2026-10-13",
  "categoryId": 2
}

###
@rejectedExpenseId = {{createExpenseToReject.response.body.$.id}}

### Envia o segundo rascunho
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{rejectedExpenseId}}/submit
Authorization: Bearer {{employeeToken}}

### Negativos: justificativa curta -> 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{rejectedExpenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "curta"
}

### Reprova com justificativa -> 200 (Rejected)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{rejectedExpenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "Falta o comprovante fiscal da corrida."
}

### Negativos: reprovar um reembolso já reprovado -> 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{rejectedExpenseId}}/reject
Authorization: Bearer {{approverToken}}
Content-Type: application/json

{
  "justification": "Falta o comprovante fiscal da corrida."
}

### Cadastro de um usuário do financeiro
# @name registerFinance
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "finance@expensehub.local",
  "password": "{{userPassword}}"
}

###
@financeId = {{registerFinance.response.body.$.id}}

### Admin atribui a role Finance
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{financeId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roles": ["Finance"]
}

### Login do financeiro
# @name loginFinance
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "finance@expensehub.local",
  "password": "{{userPassword}}"
}

###
@financeToken = {{loginFinance.response.body.$.accessToken}}

### Negativos: pagar um reembolso reprovado -> 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{rejectedExpenseId}}/pay
Authorization: Bearer {{financeToken}}

### Negativos: Approver não paga -> 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{approverToken}}

### Paga o reembolso aprovado -> 200 (Paid, com paidById e paidAtUtc)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

### Negativos: pagar de novo -> 409
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/pay
Authorization: Bearer {{financeToken}}

### Histórico completo: Created -> Updated -> Submitted -> Approved -> Paid
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{employeeToken}}

### Histórico visto pelo financeiro (reembolso pago está no escopo)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{financeToken}}

### Negativos: Approver não vê o histórico de um reembolso já pago -> 404
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/history
Authorization: Bearer {{approverToken}}
